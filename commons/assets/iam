function iam_create_secrets() {
  # Create secret for Keycloak admin credentials
  kubectl create secret generic keycloak-admin \
    --from-literal=username="${KEYCLOAK_ADMIN_USER:-admin}" \
    --from-literal=password="$KEYCLOAK_ADMIN_PASSWORD" \
    --from-literal=admin-password="$KEYCLOAK_ADMIN_PASSWORD" \
    --namespace iam

  # Create secret for Keycloak PostgreSQL credentials
  kubectl create secret generic postgresql \
    --from-literal=username="keycloak" \
    --from-literal=password="$KEYCLOAK_POSTGRES_PASSWORD" \
    --from-literal=postgres-password="$KEYCLOAK_POSTGRES_PASSWORD" \
    --namespace iam

  KEYCLOAK_PROVIDER_CREDENTIALS=$(cat <<EOF
  {
    "client_id": "crossplane-keycloak-provider",
    "client_secret": "$IAM_KEYCLOAK_PROVIDER_CLIENT_SECRET",
    "url": "${HTTP_SCHEME}://${KEYCLOAK_HOST}",
    "base_path": "",
    "realm": "$REALM"
  }
EOF
  )

  for namespace in iam iam-management; do
    kubectl create secret generic keycloak-provider \
      --from-literal=client_id="crossplane-keycloak-provider" \
      --from-literal=client_secret="$IAM_KEYCLOAK_PROVIDER_CLIENT_SECRET" \
      --from-literal=url="${HTTP_SCHEME}://${KEYCLOAK_HOST}" \
      --from-literal=base_path="" \
      --from-literal=realm="$REALM" \
      --from-literal=credentials="$KEYCLOAK_PROVIDER_CREDENTIALS" \
      --namespace "$namespace"
  done

  for namespace in iam iam-management; do
    kubectl create secret generic opa-route \
      --from-literal=client_id="${OPA_CLIENT_ID:-opa}" \
      --from-literal=client_secret="$OPA_CLIENT_SECRET" \
      --from-literal=session.secret="$IAM_OPA_SESSION_SECRET" \
      --namespace "$namespace"
  done

  kubectl create secret generic iam-keycloak \
    --from-literal=test-user-password="$KEYCLOAK_TEST_PASSWORD" \
    --namespace iam

  # Consumed by the Crossplane User CR (eoepca-user-template.yaml) that creates
  # the eoepcauser test user once IAM and Crossplane are up.
  kubectl create secret generic eoepca-user \
    --from-literal=eoepcauser-password="$KEYCLOAK_TEST_PASSWORD" \
    --namespace iam-management
}

function iam_admin_access_token() {
  ACCESS_TOKEN=
  while [ -z "$ACCESS_TOKEN" ]; do
    ACCESS_TOKEN=$( \
      curl -X POST "${HTTP_SCHEME}://auth.${INGRESS_HOST}/realms/master/protocol/openid-connect/token" \
        --silent --show-error \
        -d "username=${KEYCLOAK_ADMIN_USER}" \
        --data-urlencode "password=${KEYCLOAK_ADMIN_PASSWORD}" \
        -d "grant_type=password" \
        -d "client_id=admin-cli" \
        | jq -r '.access_token' \
    )
    if [ $? -ne 0 -o -z "$ACCESS_TOKEN" -o "$ACCESS_TOKEN" = "null" ]; then
      ACCESS_TOKEN=
      echo "[IAM setup] Failed to get access token, retrying..."
      sleep 10
    fi
  done
  echo "Access Token: ${ACCESS_TOKEN:0:20}..."

function iam_helm_values() {
  cat <<EOF
fullnameOverride: iam

global:
  storageClass: local-path
  security:
    # Required for Keycloak custom image with OPA adapter
    allowInsecureImages: true

# Settings for the IAM BB chart as a whole.
# Some settings made here are propagated to the service-specific sections
# through anchors. Make sure not to remove the anchors and references,
# because otherwise the dependent values will not be set.
# Note that further adaptations may still be needed in the service-specific
# sections below.
iam: &iam
  keycloak:
    enabled: &keycloakEnabled true
    createRoute: true
    # "Official" Keycloak URL
    url: &kcurl ${HTTP_SCHEME}://${KEYCLOAK_HOST}
    # Deviating "internal" Keycloak URL to use for cluster-internal access
    # (defaults to official URL). Only used for Crossplane provider so far.
    internalUrl: ""
    hosts:
      - auth.${INGRESS_HOST}
    paths:
      - /*
    configuration:
      useCrossplane: true
      useSecretGenerator: false
      createClients: false
      createSecretStore: false
      realm:
        create: true
        createUsingCrossplane: false
        name: &realmName "eoepca"
        displayName: EOEPCA
        placeholders:
          test_password:
            secret:
              name: iam-keycloak
              key: test-user-password
          opa_client_secret:
            secret:
              name: opa-route
              key: client_secret
        customClients:
          - clientId: ${OPA_CLIENT_ID}
            name: Open Policy Agent
            enabled: true
            protocol: openid-connect
            publicClient: false
            clientAuthenticatorType: client-secret
            secret: ${OPA_CLIENT_SECRET}
            serviceAccountsEnabled: true
            standardFlowEnabled: true
            directAccessGrantsEnabled: true
            authorizationServicesEnabled: true
            redirectUris:
              - ${HTTP_SCHEME}://opa.${INGRESS_HOST}/.apisix/redirect
            webOrigins:
              - ${HTTP_SCHEME}://opa.${INGRESS_HOST}
        customUsers:
          - username: ${KEYCLOAK_TEST_USER}
            enabled: true
            email: ${KEYCLOAK_TEST_USER}@eoepca.org
            emailVerified: true
            firstName: ${KEYCLOAK_TEST_USER}
            lastName: Testuser
            credentials:
              - type: password
                value: ${KEYCLOAK_TEST_PASSWORD}
                temporary: false
          - username: ${KEYCLOAK_TEST_ADMIN}
            enabled: true
            email: ${KEYCLOAK_TEST_ADMIN}@eoepca.org
            emailVerified: true
            firstName: ${KEYCLOAK_TEST_ADMIN}
            lastName: Admin
            credentials:
              - type: password
                value: ${KEYCLOAK_TEST_PASSWORD}
                temporary: false
            clientRoles:
              realm-management:
                - realm-admin
        customSettings:
          loginWithEmailAllowed: false
      provider:
        existingConfigRef: ""
        create: true
        createServiceAccount: true
        clientSecret: ""
        secretRef:
          name: keycloak-provider
          key: credentials
    tls:
      enabled: false
      autoGenerate: true
      tlsSecretRef: &tlsSecretRef ~
    cors:
      enabled: false
    postgres:
      enabled: true
      host: &pgHost iam-postgresql
      database: &pgDatabase keycloak
      username: keycloak
      password: ""
      secretRef: postgresql
  opa:
    enabled: true
    inline: false
    createRoute: true
    url: ${HTTP_SCHEME}://opa.${INGRESS_HOST}
    hosts:
      - opa.${INGRESS_HOST}
    paths:
      - /*
    clientId: "opa"
    clientSecretRef: opa-route
    image:
      registry: docker.io
      repository: openpolicyagent/opa
      tag: 1.19.0
      pullPolicy: IfNotPresent

  apisix:
    enabled: false
    ingressClassName: &ingressClassName "apisix"

  config:
    enabled: true
    targetNamespace: iam-management
    propagateSecrets: false

keycloak-operator:
  enabled: true
  operator:
    replicaCount: 1
  keycloak:
    enabled: true
    instances: 1
    bootstrapAdmin:
      user:
        secret: keycloak-admin
    db:
      vendor: postgres
      host: *pgHost
      port: 5432
      database: *pgDatabase
      usernameSecret:
        name: postgresql
        key: username
      passwordSecret:
        name: postgresql
        key: password
    http:
      tlsSecret: *tlsSecretRef
    hostname:
      hostname: *kcurl
    ingress:
      enabled: false
    proxy:
      headers: xforwarded
    realmimport:
      enabled: false

opal:
  enabled: true
  broadcastReplicas: 1
  image:
    client:
      registry: docker.io
      repository: permitio/opal-client
      tag: 0.9.6
    server:
      registry: docker.io
      repository: permitio/opal-server
      tag: 0.9.6
    pgsql:
      registry: docker.io
      repository: postgres
      tag: alpine
  server:
    port: 7002
    policyRepoUrl: https://github.com/EOEPCA/iam-policies.git
    policyRepoSshKey: null
    policyRepoClonePath: null
    policyRepoMainBranch: main
    pollingInterval: 300
    dataConfigSources:
      config:
        entries: []
    broadcastUri: null
    broadcastPgsql: true
    uvicornWorkers: 4
    replicas: 1
  client:
    port: 7000
    opaPort: 8181
    replicas: 1
    opaStartupData:
      config.yaml: |
        decision_logs:
          # Change this to true to get more information about authorization in the OPA pod's logs
          console: false
      policy.rego: |
        package system.authz
        import rego.v1
        jwks_request(url) := http.send({
          "url": url,
          "method": "GET",
          "force_cache": true,
          "force_cache_duration_seconds": 3600
        })
        jwks := jwks_request("http://iam-keycloak-operator-service:8080/realms/eoepca/protocol/openid-connect/certs").raw_body
        default allow_policy_evaluation := false
        allow_policy_evaluation if {
          input.method in ["GET", "POST"]
          "v1" == input.path[0]
          "data" == input.path[1]
          "system" != input.path[2]
        }
        allow_policy_evaluation if {
          "POST" == input.method
          ["v1", "query"] == input.path
        }
        allow_policy_evaluation if {
          "GET" == input.method
          input.path in [[""], ["health"]]
        }
        default verified_claims = null
        verified_claims := claims if {
          [type, token] := split(input.headers["Authorization"][_], " ")
          type == "Bearer"
          io.jwt.verify_rs256(token, jwks) == true
          claims := io.jwt.decode(token)[1]
        }
        default allow := false
        allow if {
          "root\$secret" == input.identity
        }
        allow if {
          not input.headers["Authorization"]
          allow_policy_evaluation == true
        }
        allow if {
          claims := verified_claims
          claims != null
          allow_policy_evaluation == true
        }
    extraEnv:
      OPAL_POLICY_STORE_URL: http://iam-opa:8181
      OPAL_POLICY_STORE_AUTH_TYPE: token
      OPAL_POLICY_STORE_AUTH_TOKEN: root\$secret
      OPAL_DATA_UPDATER_ENABLED: False
      OPAL_INLINE_OPA_ENABLED: False
      OPAL_INLINE_OPA_LOG_FORMAT: full
      OPAL_INLINE_OPA_CONFIG: >-
        {
          "addr": "http://0.0.0.0:8181",
          "authentication": "token",
          "authorization": "basic",
          "files": [ "/opt/opa/startup-data/policy.rego" ],
          "config_file":"/opt/opa/startup-data/config.yaml"
        }

iam-bb-config:
  enabled: true
  iam: *iam
EOF
}
